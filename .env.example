# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Note: if you leave a key blank (`KEY=`) rather than omitting the line,
# python-dotenv treats it as already-set — so agent/config.py's fallback to
# cli_project_working/.env's key won't kick in. Delete unused key lines
# entirely rather than leaving them blank.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Embeddings (Anthropic has no first-party embeddings API; Voyage is their recommended partner) ---
# Free-tier key: https://www.voyageai.com/
VOYAGE_API_KEY=

# --- Vector store (Pinecone, since Phase 4) ---
# Free tier: https://www.pinecone.io/
PINECONE_API_KEY=

# --- Auth + persistence (Phase 6) ---
# Free tier: https://www.supabase.com/ — Project Settings -> API for all three values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend origin (Phase 8) ---
# The deployed Vercel URL, so the backend's CORS setting allows it. Leave
# unset for local dev — localhost:5173 is always allowed regardless.
FRONTEND_URL=

# --- MCP servers ---
# weather_server.py / mcp_server.py live in mcp_servers/ (vendored from the
# sibling cli_project_working project in Phase 8, so deployment doesn't
# depend on that sibling folder existing). This is only needed if you want
# to fall back to the *original* sibling copies during local dev instead —
# safe to leave unset otherwise.
CLI_PROJECT_DIR=../cli_project_working
USE_UV=1
